{
  "name": "vacuum-network-service",
  "version": "1.0.0",
  "description": "Steady-state and pump-down calculation service for vacuum piping networks",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
